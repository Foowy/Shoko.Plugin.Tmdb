<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Shoko TMDB Metadata</Title>
        <Authors>Shoko Team</Authors>
        <Version>1.2.0</Version>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shoko.Plugin.Tmdb.Tests" />
    </ItemGroup>

    <!-- The server supplies the abstractions at runtime, and a plugin that
         ships its own copy resolves `IPlugin` against that copy and is then
         skipped without an error, so the dll and the packages it brings stay
         out of the output. -->
    <ItemGroup Condition="'$(ShokoRepositoryPath)' != ''">
        <ProjectReference Include="$(ShokoRepositoryPath)/Shoko.Abstractions/Shoko.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
        <!-- Checks the plugin's configurations and actions with the analyzer,
             which is only built from a checkout. -->
        <ProjectReference Include="$(ShokoRepositoryPath)/Shoko.BuildTools.Analyzers/Shoko.BuildTools.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(ShokoRepositoryPath)' == ''">
        <PackageReference Include="Shoko.Abstractions" Version="$(ShokoAbstractionsVersion)" ExcludeAssets="runtime" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- The plugin's own TMDB client, built from its submodule until a
             release newer than 3.0.0 is published. It targets net8.0 too,
             which nothing here uses, so the solution does not list it. -->
        <ProjectReference Include="..\ext\TMDbLib\TMDbLib\TMDbLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The plugin's thumbnail and icon, read by the server through the
             plugin. The icon is the source's icon too, named by the provider. -->
        <EmbeddedResource Include="Assets\thumbnail.svg" LogicalName="Shoko.Plugin.Tmdb.Assets.thumbnail.svg" />
        <EmbeddedResource Include="Assets\icon.svg" LogicalName="Shoko.Plugin.Tmdb.Assets.icon.svg" />
    </ItemGroup>

    <ItemGroup>
        <!-- Injects the embedded plugin identity metadata the server reads during
             discovery, from the `manifest.json` at the repository root. -->
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.3.3" PrivateAssets="All" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
